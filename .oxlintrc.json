{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "plugins": ["typescript", "unicorn", "oxc", "import", "promise"],
  "jsPlugins": [
    { "name": "fp", "specifier": "eslint-plugin-fp" },
    { "name": "bun", "specifier": "eslint-plugin-bunisms" }
  ],
  "options": {
    "typeAware": true,
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error",
    "respectEslintDisableDirectives": false
  },
  "rules": {
    "fp/no-arguments": "error",
    "fp/no-class": "error",
    "fp/no-delete": "error",
    "fp/no-events": "error",
    "fp/no-get-set": "error",
    "fp/no-let": "error",
    "fp/no-loops": "error",
    "fp/no-mutating-assign": "error",
    "fp/no-mutating-methods": "error",
    "fp/no-mutation": "error",
    "fp/no-nil": "error",
    "fp/no-proxy": "error",
    "fp/no-rest-parameters": "error",
    "fp/no-this": "error",
    "fp/no-throw": "error",
    "fp/no-unused-expression": "error",
    "fp/no-valueof-field": "error",
    "bun/no-dotenv": "error",
    "bun/no-late-module-mock": "error",
    "bun/prefer-bun-crypto-hasher": "error",
    "bun/prefer-bun-file": "error",
    "bun/prefer-bun-shell": "error",
    "bun/prefer-bun-spawn": "error",
    "bun/prefer-bun-write": "error",
    "bun/prefer-fetch": "error",
    "bun/prefer-import-meta-dir": "error",
    "bun/prefer-import-meta-main": "error",
    "bun/prefer-import-meta-path": "error",
    "bun/prefer-import-meta-resolve": "error",
    "bun/prefer-mock-restore-in-after-each": "error",
    "eqeqeq": "error",
    "no-eval": "error",
    "no-new-func": "error",
    "no-unsafe-finally": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-floating-promises": ["error", { "checkThenables": true, "ignoreVoid": false }],
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "typescript/no-unsafe-type-assertion": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/ban-ts-comment": ["error", {
      "ts-expect-error": true,
      "ts-ignore": true,
      "ts-nocheck": true,
      "ts-check": false
    }],
    "typescript/consistent-type-assertions": ["error", { "assertionStyle": "never" }],
    "typescript/consistent-type-definitions": ["error", "type"],
    "typescript/consistent-type-imports": "error",
    "typescript/consistent-type-exports": "error",
    "typescript/explicit-function-return-type": ["error", {
      "allowDirectConstAssertionInArrowFunctions": false,
      "allowHigherOrderFunctions": false,
      "allowTypedFunctionExpressions": false
    }],
    "typescript/explicit-module-boundary-types": ["error", {
      "allowDirectConstAssertionInArrowFunctions": false,
      "allowHigherOrderFunctions": false,
      "allowTypedFunctionExpressions": false
    }],
    "typescript/no-base-to-string": "error",
    "typescript/no-confusing-void-expression": "error",
    "typescript/no-deprecated": "error",
    "typescript/no-dynamic-delete": "error",
    "typescript/no-extraneous-class": "error",
    "typescript/no-import-type-side-effects": "error",
    "typescript/no-invalid-void-type": "error",
    "typescript/no-namespace": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-require-imports": "error",
    "typescript/no-restricted-types": ["error", { "types": {
      "Array": "Use readonly T[] or ReadonlyArray<T>.",
      "Map": "Use ReadonlyMap<K, V>.",
      "Set": "Use ReadonlySet<T>.",
      "WeakMap": "Do not expose mutable weak collections in data contracts.",
      "WeakSet": "Do not expose mutable weak collections in data contracts.",
      "Date": "Use an immutable timestamp or an immutable date representation."
    } }],
    "typescript/no-unnecessary-condition": ["error", { "checkTypePredicates": true }],
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/prefer-function-type": "error",
    "typescript/prefer-readonly-parameter-types": "error",
    "typescript/method-signature-style": ["error", "property"],
    "typescript/require-array-sort-compare": "error",
    "typescript/restrict-plus-operands": ["error", {
      "allowAny": false,
      "allowBoolean": false,
      "allowNullish": false,
      "allowNumberAndString": false,
      "allowRegExp": false
    }],
    "typescript/restrict-template-expressions": ["error", {
      "allow": [],
      "allowAny": false,
      "allowArray": false,
      "allowBoolean": false,
      "allowNever": false,
      "allowNullish": false,
      "allowNumber": false,
      "allowRegExp": false
    }],
    "typescript/return-await": ["error", "always"],
    "typescript/strict-boolean-expressions": ["error", {
      "allowAny": false,
      "allowNullableBoolean": false,
      "allowNullableEnum": false,
      "allowNullableNumber": false,
      "allowNullableObject": false,
      "allowNullableString": false,
      "allowNumber": false,
      "allowString": false
    }],
    "typescript/strict-void-return": "error",
    "typescript/unbound-method": "error",
    "typescript/use-unknown-in-catch-callback-variable": "error",
    "array-callback-return": ["error", { "checkForEach": true }],
    "max-classes-per-file": ["error", { "max": 0, "ignoreExpressions": false }],
    "no-restricted-imports": ["error", { "paths": [
      { "name": "events", "message": "Use explicit function/data flow instead of event-driven shared state." },
      { "name": "node:events", "message": "Use explicit function/data flow instead of event-driven shared state." }
    ] }],
    "no-restricted-properties": ["error",
      { "object": "Promise", "property": "reject", "message": "Return an explicit error result instead of rejecting a Promise." },
      { "property": "set", "message": "Return new immutable data instead of calling a mutating setter." },
      { "property": "add", "message": "Return a new immutable collection instead of adding in place." },
      { "property": "clear", "message": "Return a new empty collection instead of clearing shared state." },
      { "property": "delete", "message": "Return a new collection instead of deleting in place." }
    ],
    "no-await-in-loop": "error",
    "no-implicit-coercion": "error",
    "no-new": "error",
    "no-param-reassign": ["error", { "props": true }],
    "no-plusplus": "error",
    "no-return-assign": ["error", "always"],
    "no-var": "error",
    "no-void": "error",
    "object-shorthand": ["error", "always"],
    "prefer-arrow-callback": ["error", { "allowNamedFunctions": false, "allowUnboundThis": false }],
    "prefer-const": "error",
    "prefer-object-spread": "error",
    "prefer-spread": "error",
    "import/no-commonjs": "error",
    "import/no-cycle": "error",
    "import/no-default-export": "error",
    "import/no-mutable-exports": "error",
    "import/no-self-import": "error",
    "import/no-unassigned-import": "error",
    "promise/avoid-new": "error",
    "promise/prefer-await-to-callbacks": "error",
    "promise/prefer-await-to-then": "error",
    "unicorn/no-array-for-each": "error",
    "unicorn/no-array-sort": "error",
    "unicorn/no-array-reverse": "error",
    "unicorn/no-array-method-this-argument": "error",
    "unicorn/no-immediate-mutation": "error",
    "unicorn/no-this-assignment": "error",
    "unicorn/consistent-function-scoping": "error"
  },
  "ignorePatterns": ["baml_sdk/**"]
}
